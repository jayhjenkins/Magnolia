#!/usr/bin/env bash
# magnolia - launch the Magnolia board. Resolves its own (possibly symlinked)
# location to find the repo, then hands off to the Python launcher.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
dir="$(cd -P "$(dirname "$src")" && pwd)"
exec python3 "$dir/../scripts/magnolia.py" "$@"
