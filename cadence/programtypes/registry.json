{
  "families": [
    { "id": "roadmap",  "label": "Roadmap",  "order": 1 },
    { "id": "weekly",   "label": "Weekly",   "order": 2 },
    { "id": "outcomes", "label": "Outcomes", "order": 3 },
    { "id": "eos",      "label": "EOS",      "order": 4 },
    { "id": "system",   "label": "System",   "order": 99 }
  ],
  "types": [
    { "id": "roadmap-initiative", "label": "Roadmap initiative", "family": "roadmap",
      "state_model": "pipeline",
      "archive_after_silent_cycles": 6,
      "archive_cooldown_days": 14,
      "phases": [
        { "id": "discovery", "label": "Discovery", "max_age_days": 21, "exit_checkpoint": "discovery-exit", "description": "Exploring the problem space, talking to customers, gathering requirements. No committed solution yet." },
        { "id": "planning",  "label": "Planning",  "max_age_days": 14, "exit_checkpoint": "planning-exit", "description": "Solution defined and scoped. Engineering work planned but not yet started." },
        { "id": "execution", "label": "Execution", "exit_checkpoint": "ship", "description": "Active engineering build in progress. Code being written, tested, and reviewed." },
        { "id": "shipped",   "label": "Shipped", "description": "Deployed to production and accessible to real customers. Testing or QA environments do not count as shipped." },
        { "id": "verified",  "label": "Verified", "terminal": true, "description": "Shipped feature confirmed working in production with measured outcomes. No outstanding critical bugs blocking usage." }
      ],
      "cadence": "weekly",
      "sources": [ { "kind": "transcripts", "mode": "read" }, { "kind": "project_management", "mode": "read" } ],
      "emitters": [ { "on": "drift:broken", "action": "escalate" }, { "on": "phase-advance-proposable", "action": "propose-update" }, { "on": "completion-verified", "action": "propose-update" }, { "on": "silent-too-long", "action": "propose-update" }, { "on": "tracker-status-mismatch", "action": "propose-update" }, { "on": "date-drift", "action": "propose-update" } ],
      "intake": {
        "route": "candidate",
        "signals": [
          "kickoff/initiative language",
          "new epic appears in tracker",
          "recurring theme with an owner and an outcome"
        ],
        "birth_threshold": { "min_independent_sources": 2, "or_explicit_declaration": true },
        "bootstrap_emissions": [
          { "action": "draft-ticket",   "template": "create-tracker-initiative" },
          { "action": "propose-update", "template": "add-roadmap-entry" }
        ]
      },
      "presentation": { "chip_tokens": { "discovery": "--text-dim", "execution": "--accent" } } },

    { "id": "weekly-priorities", "label": "Weekly priorities", "family": "weekly",
      "state_model": "cycle", "cadence": "weekly",
      "sources": [ { "kind": "transcripts", "mode": "read" } ],
      "emitters": [
        { "on": "drift:broken", "action": "escalate" },
        { "on": "cycle-fresh", "action": "produce-artifact", "worker": "priority-digest", "fire_weekday": 1 }
      ],
      "intake": { "route": "capture" },
      "presentation": { "chip_tokens": {} } },

    { "id": "eng-sync-prep", "label": "Eng sync prep", "family": "weekly",
      "state_model": "cycle", "cadence": "weekly",
      "sources": [ { "kind": "team_threads", "mode": "read" } ],
      "emitters": [ { "on": "drift:broken", "action": "escalate" } ],
      "intake": { "route": "capture" },
      "presentation": { "chip_tokens": {} } },

    { "id": "did-it-work", "label": "Did it work?", "family": "outcomes",
      "state_model": "target", "cadence": "weekly",
      "sources": [ { "kind": "metrics", "mode": "read" } ],
      "emitters": [ { "on": "drift:broken", "action": "escalate" }, { "on": "completion-verified", "action": "propose-update" } ],
      "presentation": { "chip_tokens": {} } },

    { "id": "eos-rock", "label": "EOS rock", "family": "eos",
      "state_model": "pipeline",
      "archive_cooldown_days": 21,
      "phases": [
        { "id": "define", "label": "Define", "max_age_days": 14, "exit_checkpoint": "define-exit", "description": "Scoping and defining the rock. Success criteria and milestones being established." },
        { "id": "build",  "label": "Build",  "max_age_days": 42, "exit_checkpoint": "build-exit", "description": "Active development and execution toward the rock's goals. Work is in progress." },
        { "id": "beta",   "label": "Beta",   "max_age_days": 21, "exit_checkpoint": "beta-exit", "description": "Changes deployed and being validated against success metrics. Metric targets not yet met." },
        { "id": "ga",     "label": "GA", "terminal": true, "description": "Rock complete. Success metrics achieved or measurably close to target. All key checkpoints met and no critical blockers remain." }
      ],
      "cadence": "weekly",
      "sources": [ { "kind": "eos_sheet", "mode": "read" } ],
      "sentinels": ["sheet-watch"],
      "emitters": [ { "on": "drift:broken", "action": "escalate" }, { "on": "phase-advance-proposable", "action": "propose-update" }, { "on": "completion-verified", "action": "propose-update" }, { "on": "silent-too-long", "action": "propose-update" }, { "on": "tracker-status-mismatch", "action": "propose-update" }, { "on": "date-drift", "action": "propose-update" } ],
      "intake": {
        "route": "candidate",
        "signals": [ "quarterly rock commitment declared in a leadership session" ],
        "birth_threshold": { "explicit_declaration_only": true }
      },
      "presentation": { "chip_tokens": {} } },

    { "id": "eos-cycle", "label": "EOS cycle", "family": "eos",
      "state_model": "cycle", "cadence": "weekly",
      "sources": [ { "kind": "eos_sheet", "mode": "read" } ],
      "sentinels": ["sheet-watch"],
      "emitters": [ { "on": "drift:broken", "action": "escalate" } ],
      "intake": { "route": "capture" },
      "presentation": { "chip_tokens": {} } },

    { "id": "eos-issues", "label": "EOS issues", "family": "eos",
      "state_model": "register", "cadence": "weekly",
      "sources": [ { "kind": "eos_sheet", "mode": "read" } ],
      "sentinels": ["sheet-watch"],
      "emitters": [ { "on": "drift:broken", "action": "escalate" } ],
      "presentation": { "chip_tokens": {} } },

    { "id": "eos-l10-prep", "label": "EOS L10 prep", "family": "eos",
      "state_model": "cycle", "cadence": "weekly",
      "sources": [ { "kind": "eos_sheet", "mode": "read" } ],
      "sentinels": ["sheet-watch"],
      "emitters": [
        { "on": "drift:broken", "action": "escalate" },
        { "on": "cycle-fresh", "action": "draft-message", "template": "l10-prep-nudge", "max_nudges_per_person_per_week": 2, "fire_weekday": 2 }
      ],
      "intake": { "route": "capture" },
      "presentation": { "chip_tokens": {} } },

    { "id": "program-intake", "label": "Program intake", "family": "system",
      "state_model": "register", "cadence": "weekly",
      "sources": [ { "kind": "transcripts", "mode": "read" } ],
      "emitters": [
        { "on": "candidate-ripe", "action": "propose-update" },
        { "on": "drift:broken", "action": "escalate" }
      ],
      "presentation": { "chip_tokens": {} } },

    { "id": "portfolio-health", "label": "Portfolio health", "family": "system",
      "state_model": "register", "cadence": "weekly",
      "sources": [ { "kind": "transcripts", "mode": "read" } ],
      "emitters": [
        { "on": "drift:broken", "action": "escalate" }
      ],
      "presentation": { "chip_tokens": {} } },

    { "id": "product-review-prep", "label": "Product review prep", "family": "weekly",
      "state_model": "cycle", "cadence": "monthly",
      "sources": [ { "kind": "transcripts", "mode": "read" }, { "kind": "product_analytics", "mode": "read" } ],
      "emitters": [
        { "on": "drift:broken", "action": "escalate" },
        { "on": "cycle-fresh", "action": "produce-artifact", "worker": "product-review-prep", "fire_weekday": 1, "fire_month_occurrence": 2 }
      ],
      "intake": { "route": "capture" },
      "presentation": { "chip_tokens": {} } },

    { "id": "portfolio-rollup", "label": "Portfolio rollup", "family": "system",
      "state_model": "cycle", "cadence": "weekly",
      "sources": [ { "kind": "transcripts", "mode": "read" } ],
      "emitters": [
        { "on": "drift:broken", "action": "escalate" },
        { "on": "cycle-fresh", "action": "produce-artifact", "worker": "portfolio-rollup", "min_active_families": 2 }
      ],
      "intake": { "route": "ignore" },
      "presentation": { "chip_tokens": {} } }
  ]
}
