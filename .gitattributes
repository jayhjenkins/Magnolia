# Line endings that must survive a Windows checkout (core.autocrlf=true is the
# Git for Windows default). Shell scripts run under bash / Git Bash and break on
# CRLF ("$'\r': command not found", "/usr/bin/env: 'bash\r'").
*.sh        text eol=lf
bin/magnolia text eol=lf

# Windows-native scripts: CRLF is what cmd.exe / PowerShell expect.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf
